

&dma1 {
    status="okay";
};
&dma2 {
    status="okay";
};

&usart2 {
    current-speed = <921600>;
	dmas = <&dma1 6 4 (STM32_DMA_PERIPH_TX) STM32_DMA_FIFO_FULL
		&dma1 5 4 (STM32_DMA_MODE_CYCLIC | STM32_DMA_PERIPH_RX | STM32_DMA_MEM_8BITS) STM32_DMA_FIFO_FULL>;
	dma-names = "tx", "rx";
	fifo-enable;
};

&usart1 {
    status="okay";
};



/ {
	chosen {
		zephyr,display = &ssd1306_ssd1306_128x64_spi;
        zephyr,log-uart=&log_uarts;
        zephyr,console = &usart1;
        zephyr,shell-uart = &usart1;
	};

    log_uarts: log_uart_node {
        compatible = "zephyr,log-uart";
        uarts=<&usart2>;
        status = "okay";
    };

    sram@2001E000 {
        compatible = "zephyr,memory-region", "mmio-sram";
        reg = <0x2001E000 DT_SIZE_K(8)>;
        zephyr,memory-region = "RetainedMem";

        retainedmem {
            compatible = "zephyr,retained-ram";
            status = "okay";
            #address-cells = <1>;
            #size-cells = <1>;
            instrumentation_triggers: retention@0 {
                compatible = "zephyr,retention";
                status = "okay";
                reg = <0x0 0x2000>;
            };
        };
    };
};

&spi1{
    /delete-node/ ssd1306@0;

};

&spi2 {
    pinctrl-0 = <&spi2_nss_pb12 &spi2_sck_pb13
                 &spi2_miso_pb14 &spi2_mosi_pb15>;
	pinctrl-names = "default";
	status = "okay";

	ssd1306_ssd1306_128x64_spi: ssd1306@0 {
		compatible = "solomon,ssd1306fb";
		reg = <0x0>;
		spi-max-frequency = <10000000>;
		width = <128>;
		height = <64>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		segment-remap;
		com-invdir;
        inversion-on;
		prechargep = <0x22>;
		data-cmd-gpios = <&st_morpho_header ST_MORPHO_L_32 0>;
		reset-gpios = <&st_morpho_header ST_MORPHO_L_28 GPIO_ACTIVE_LOW>;
	};
};



//TODO
&spi1 {
    dac: dac_0 {
        compatible = "ad,ad5686";
        reset-gpios = <&st_morpho_header ST_MORPHO_L_30 GPIO_ACTIVE_LOW>;
        status = "okay";
    };
};

&sram0 {
    reg = <0x20000000 DT_SIZE_K(120)>;
};
